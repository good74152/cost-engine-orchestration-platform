# Copy outside Git or to ignored deploy/.env. Never put secrets here.
DEPLOYMENT_VERSION=REPLACE_WITH_GIT_COMMIT
DEMO_PUBLIC_ORIGIN=https://demo.example.com
ACME_EMAIL=operator@example.com
DEMO_SECRETS_DIR=/opt/cost-engine-demo/secrets
DEMO_MAX_ACTIVE_SESSIONS=100
DEMO_MAX_RETAINED_SESSIONS=10000
DEMO_MAX_EXECUTORS=100
DEMO_CREATES_PER_MINUTE=10
DEMO_MUTATIONS_PER_MINUTE=120
DEMO_GLOBAL_MUTATIONS_PER_MINUTE=600
DEMO_BODY_BYTES=16384
DEMO_MAINTENANCE_INTERVAL_MS=60000
DEMO_MAINTENANCE_BATCH=25
