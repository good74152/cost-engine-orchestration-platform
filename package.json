{
  "name": "cost-engine-orchestration-platform",
  "version": "1.0.0",
  "description": "Backend orchestration platform for versioned cost-engine datasets and Airflow/ETL execution workflows.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate -j ts",
    "test:dataset-version-creation-v2": "tsx --test scripts/dataset-version-creation-v2.pg.test.ts",
    "test:first-run-immutable-build-snapshot": "tsx --test scripts/first-run-immutable-build-snapshot.pg.test.ts",
    "test:execution-attempt-dispatch-fake-executor": "tsx --test scripts/execution-attempt-dispatch-fake-executor.pg.test.ts",
    "test:orchestration-schema-v2": "tsx --test scripts/orchestration-schema-v2.pg.test.ts",
    "test:raw-ingestion": "tsx --test scripts/raw-ingestion.route.test.ts"
  },
  "keywords": [
    "orchestration",
    "airflow",
    "etl",
    "cost-engine",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
